# ── 색인 ──────────────────────────────────────────────────────────────
# 24_build_index.py 가 다시 만든다.
index/embeddings.npy          # 약 30MB
index/bm25.pkl                # rank_bm25 버전이 다르면 언피클 실패
index/query_cache*.npz        # 25 첫 실행 시 자동 생성
index/index_meta.json
# index/chunks.jsonl 은 공개 여부를 따로 판단한다. 넣기로 했다면
# 아래 줄을 지운다.
index/chunks.jsonl

